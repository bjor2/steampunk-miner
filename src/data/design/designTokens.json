{
  "colour": {
    "bg": "#1b1613",
    "panel": "#1b1613",
    "text": "#f3ead8",
    "parchment": "#e9dcc0",
    "brass": "#c9a24b",
    "copper": "#b87333",
    "amber": "#e0a040",
    "teal": "#3fa7a0",
    "verdigris": "#4fa8a0",
    "ember": "#e0602a",
    "iron": "#3a3632",
    "steel": "#8a94a0",
    "danger": "#c8382a",
    "accent": "#c9a24b",
    "accentSoft": "#e0a040",
    "glow": "#e0a040",
    "dialFace": "#e9dcc0"
  },
  "panelOpacity": 0.85,
  "materials": {
    "brass": { "highlight": "#efd27a", "base": "#c9a24b", "shadow": "#6e5220" },
    "copper": { "highlight": "#e0995c", "base": "#b87333", "shadow": "#5e3414" },
    "iron": { "highlight": "#5c5650", "base": "#3a3632", "shadow": "#17140f" },
    "steel": { "highlight": "#b8c0c8", "base": "#8a94a0", "shadow": "#454c54" },
    "parchment": { "highlight": "#f6efdc", "base": "#e9dcc0", "shadow": "#b9a888" }
  },
  "glassSheenOpacity": 0.08,
  "gaugeFills": { "hull": "copper", "fuel": "amber", "cargo": "verdigris", "heat": "ember" },
  "type": {
    "fontBody": "'Georgia', 'Times New Roman', serif",
    "fontNumerals": "ui-monospace, 'Cascadia Mono', Consolas, monospace",
    "minPx": 14,
    "sizesPx": { "label": 14, "body": 16, "odometer": 18, "title": 20, "display": 24 },
    "lineHeight": 1.3,
    "labelTrackingEm": 0.08
  },
  "spacePx": { "1": 4, "2": 8, "3": 16, "4": 24, "5": 32 },
  "radiusPx": { "panel": 6, "card": 4, "chip": 12 },
  "framePx": { "hairline": 1, "bezel": 2, "double": 3, "rivet": 3 },
  "motion": {
    "transitionMaxMs": 200,
    "durationsMs": { "instant": 80, "quick": 120, "standard": 160, "sheet": 200 },
    "easing": {
      "enter": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "needle": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "needle": { "easeMinMs": 150, "easeMaxMs": 250, "overshootShare": 0.06, "lagMaxMs": 300 },
    "odometer": { "rollMaxMs": 600, "digitMs": 120 },
    "floatUpMs": 600,
    "glowPulseMs": 1000,
    "toastMaxMs": 2000,
    "reduceMotion": {
      "transition": "fade",
      "needle": "snap",
      "odometer": "set",
      "floatUp": "fade",
      "glow": "steady"
    }
  },
  "warningLadder": {
    "tiers": [
      { "name": "low", "atPercent": 30, "colour": "amber", "hapticMs": 10 },
      { "name": "critical", "atPercent": 15, "colour": "ember", "hapticMs": 30 },
      { "name": "empty", "atPercent": 0, "colour": "danger", "hapticMs": 60 }
    ],
    "rearmPercent": 5,
    "glow": { "thicknessPx": { "phone": 24, "desktop": 32 }, "opacity": 0.6 }
  },
  "haptics": { "tapMs": 10, "longPressMs": 10, "setting": "haptics" },
  "soundCues": [
    { "id": "ui.tap", "voices": 2, "family": "click", "maxMs": 80, "when": "a control is pressed" },
    { "id": "ui.tab", "voices": 1, "family": "ratchet", "maxMs": 120, "when": "a tab is chosen" },
    {
      "id": "ui.reveal",
      "voices": 1,
      "family": "click",
      "maxMs": 80,
      "when": "a first tap shows a card's line"
    },
    {
      "id": "ui.sheet.open",
      "voices": 1,
      "family": "shutter",
      "maxMs": 200,
      "when": "a sheet slides in"
    },
    {
      "id": "ui.sheet.close",
      "voices": 1,
      "family": "shutter",
      "maxMs": 200,
      "when": "a sheet slides out"
    },
    { "id": "ui.buy", "voices": 2, "family": "ratchet", "maxMs": 300, "when": "Buy succeeds" },
    { "id": "ui.fit", "voices": 1, "family": "clank", "maxMs": 200, "when": "Fit seats an item" },
    { "id": "ui.sell", "voices": 2, "family": "chime", "maxMs": 400, "when": "Sell pays out" },
    {
      "id": "ui.scrap",
      "voices": 1,
      "family": "clank",
      "maxMs": 300,
      "when": "Scrap is confirmed"
    },
    { "id": "ui.travel", "voices": 1, "family": "whistle", "maxMs": 600, "when": "Travel starts" },
    {
      "id": "ui.refuse",
      "voices": 1,
      "family": "clank",
      "maxMs": 200,
      "when": "a command is refused"
    },
    {
      "id": "ui.warn.low",
      "voices": 1,
      "family": "bell",
      "maxMs": 400,
      "when": "a gauge hits 30%"
    },
    {
      "id": "ui.warn.critical",
      "voices": 1,
      "family": "bell",
      "maxMs": 400,
      "when": "a gauge hits 15%"
    },
    {
      "id": "ui.warn.empty",
      "voices": 1,
      "family": "bell",
      "maxMs": 600,
      "when": "a gauge hits 0%"
    },
    {
      "id": "ui.odometer",
      "voices": 1,
      "family": "tick",
      "maxMs": 600,
      "when": "the money odometer rolls"
    },
    { "id": "ui.toast", "voices": 1, "family": "chime", "maxMs": 200, "when": "a toast shows" },
    {
      "id": "ui.slot.ready",
      "voices": 1,
      "family": "tick",
      "maxMs": 120,
      "when": "a slot's cooldown ring completes"
    }
  ],
  "layout": {
    "breakpoints": {
      "phone": { "coarseShortAxisBelowPx": 800, "anyPointerShortAxisBelowPx": 500 }
    },
    "tapTargetMinPx": 44,
    "coarseTargetPx": 56,
    "topKeepOutPercent": 15,
    "thumbZoneHeightPercent": 45,
    "stickZoneWidthPercent": 40,
    "middleBand": { "topPercent": 30, "bottomPercent": 70 },
    "edgeLanePx": 8,
    "marginPx": 8,
    "strip": {
      "heightPx": { "phone": 36, "desktop": 44 },
      "maxWidthPx": { "phone": 600, "desktop": 720 },
      "barHeightPx": 8,
      "heatShowsAbovePercent": 60
    },
    "edgeGauge": { "widthPx": 4, "slotLengthPx": 24 },
    "statusIcons": { "count": { "phone": 3, "desktop": 6 }, "sizePx": 16 },
    "toolSlots": {
      "count": { "phone": 4, "desktop": 8 },
      "overflow": { "phone": true, "desktop": true },
      "columns": { "phonePortrait": 3, "phoneLandscape": 6, "desktop": 10 },
      "cellPx": { "phone": 44, "desktop": 48 },
      "gapPx": 4,
      "cooldownRingPx": 3
    },
    "tabsMax": 8,
    "sheetDock": { "widthPx": 400, "minViewPx": 640 },
    "coverageMaxPercent": { "phone": 12, "desktop": 8 },
    "mockups": [
      { "name": "phone", "width": 360, "height": 640 },
      { "name": "desktop", "width": 1440, "height": 900 }
    ]
  },
  "copy": {
    "titleWordsMax": 3,
    "hoverWordsMax": 12,
    "toastWordsMax": 6,
    "verbs": ["Buy", "Fit", "Sell", "Scrap", "Travel"],
    "places": {
      "outfitter": "Outfitter",
      "patentOffice": "Patent Office",
      "hold": "Hold",
      "ledger": "Ledger",
      "gearbox": "Gearbox"
    }
  },
  "numbers": {
    "significantFigures": 3,
    "maxChars": 6,
    "wholeBelow": 10000,
    "suffixes": ["k", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"],
    "depthKmFromMetres": 10000,
    "depthKmDecimals": 1,
    "speedSignificantFigures": 3
  },
  "art": {
    "gaugeBar": "ui-gauge-bar",
    "gaugeDial": "ui-gauge-dial",
    "gaugeNeedle": "ui-gauge-needle",
    "edgeGauge": "ui-edge-gauge",
    "odometerDrum": "ui-odometer-drum",
    "sheetFrame": "ui-frame-sheet",
    "cardFrame": "ui-frame-card",
    "glassFrame": "ui-frame-glass",
    "tabFrame": "ui-frame-tab",
    "scrollRail": "ui-scroll-rail",
    "slotRing": "ui-slot-ring",
    "statusPlate": "ui-status-plate",
    "gearButton": "ui-gear-button"
  },
  "skinnable": ["accent", "accentSoft", "glow", "dialFace"],
  "planetSkins": {
    "palette.planet_1": { "accent": "#c9a24b", "accentSoft": "#e0a040", "glow": "#e0a040" },
    "palette.planet_2": { "accent": "#8a7aa8", "accentSoft": "#b9a8d8", "glow": "#9a86c8" },
    "palette.heat": { "accent": "#c4532e", "accentSoft": "#ff8a2a", "glow": "#ff8a2a" }
  }
}
