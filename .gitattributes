* text=auto eol=lf
# Blender sources live in the repo under Git LFS (#52); exports are generated by scripts/art.
*.blend filter=lfs diff=lfs merge=lfs -text
*.ktx2 binary
# Append-only perf history (docs/perf/README.md): concurrent branches each add lines at the end;
# a union merge keeps both sides instead of conflicting on rebase.
docs/perf/history.ndjson merge=union
