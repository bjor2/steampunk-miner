{
  "$comment": [
    "Affected-spec selection for the browser e2e layer (#190), read by scripts/e2e/affectedSpecs.mjs.",
    "Each changed path is looked up in order: a browser spec runs itself; a fullSuite path runs every spec;",
    "a noBrowserEffect path runs none; otherwise every rule whose paths match adds its specs, and a path",
    "no rule matches runs every spec. Every spec loads the whole game, so a rule names the specs that",
    "exercise the change, and the nightly full run catches a cross-feature miss.",
    "affectedSpecs.test.mjs checks that every spec under e2e/browser is named by a rule."
  ],
  "fullSuite": [
    "playwright.config.ts",
    "vite.config.ts",
    "package.json",
    "package-lock.json",
    "index.html",
    "tsconfig*.json",
    "e2e/affected.json",
    "e2e/browser/**",
    "scripts/e2e/**"
  ],
  "noBrowserEffect": [
    "**/*.md",
    "docs/**",
    "tests/**",
    "art/**",
    "scripts/**",
    "src/**/*.test.ts",
    "electron/**",
    "electron-builder.yml",
    "playwright.electron.config.ts",
    "tsconfig.electron.json",
    "e2e/packaged/**",
    "scenarios/bot-*.scenario.json"
  ],
  "rules": [
    {
      "why": "The example slice answers smoke's features read, opens the slice screen and hangs the test piece.",
      "paths": ["src/features/example/**"],
      "specs": [
        "e2e/browser/smoke.spec.ts",
        "e2e/browser/sliceScreen.spec.ts",
        "e2e/browser/vehiclePieces.spec.ts"
      ]
    },
    {
      "why": "The mining popup's chips and plaque, and the dig in the look set.",
      "paths": ["src/features/mining-popup/**"],
      "specs": ["e2e/browser/miningPopup.spec.ts", "e2e/browser/screens/reviewShots.spec.ts"]
    },
    {
      "why": "The power-up loadout and its HUD slots.",
      "paths": ["src/features/power-up-core/**"],
      "specs": [
        "e2e/browser/powerUpCore.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts",
        "e2e/browser/screens/slotHoldRing.spec.ts"
      ]
    },
    {
      "why": "The bore gun's fire tile beside the power-up slots, its recovery ring and the reticle on the overlay.",
      "paths": ["src/features/ground-gun/**"],
      "specs": ["e2e/browser/screens/fireTile.spec.ts", "e2e/browser/screens/screenLayout.spec.ts"]
    },
    {
      "why": "The sensing lane's items in the slots, the reveal layer and board, the passives' HUD panels, and on the rig.",
      "paths": ["src/features/sensing/**"],
      "specs": [
        "e2e/browser/sensing.spec.ts",
        "e2e/browser/powerUpCore.spec.ts",
        "e2e/browser/rigGear.spec.ts"
      ]
    },
    {
      "why": "The drill-gear lane's items in the drill sockets, their keys and their card lines.",
      "paths": ["src/features/drill-gear/**"],
      "specs": ["e2e/browser/drillGear.spec.ts", "e2e/browser/powerUpCore.spec.ts"]
    },
    {
      "why": "The mobility lane's items in the slots, their effect windows and their card lines, and on the rig.",
      "paths": ["src/features/mobility/**"],
      "specs": [
        "e2e/browser/mobility.spec.ts",
        "e2e/browser/powerUpCore.spec.ts",
        "e2e/browser/screens/slotHoldRing.spec.ts",
        "e2e/browser/rigGear.spec.ts"
      ]
    },
    {
      "why": "The tech gear on the rig, the Mark plates and the power-up effects (ticket 250).",
      "paths": [
        "src/features/tech-tree/scene/**",
        "src/features/tech-tree/store/rigReads.ts",
        "src/features/tech-tree/store/powerUpFxFeed.ts",
        "src/features/tech-tree/systems/render/**",
        "src/features/tech-tree/techGear.json"
      ],
      "specs": ["e2e/browser/rigGear.spec.ts", "e2e/browser/vehiclePieces.spec.ts"]
    },
    {
      "why": "The sized charge rack hangs as a vehicle piece; the blast front and planted charges are scene layers inside the frame budget.",
      "paths": ["src/features/dynamite-visuals/**"],
      "specs": [
        "e2e/browser/dynamiteVisuals.spec.ts",
        "e2e/browser/vehiclePieces.spec.ts",
        "e2e/browser/render.spec.ts"
      ]
    },
    {
      "why": "The terrain lane's tools in the slots, the planted lodestone beacon and the card lines; the magnet fields' layer (ticket 286).",
      "paths": ["src/features/terrain-tools/**"],
      "specs": [
        "e2e/browser/terrainTools.spec.ts",
        "e2e/browser/powerUpCore.spec.ts",
        "e2e/browser/magnetFields.spec.ts",
        "e2e/browser/render.spec.ts"
      ]
    },
    {
      "why": "The sell burst on the bay header.",
      "paths": ["src/features/sell-burst/**"],
      "specs": ["e2e/browser/sellBurst.spec.ts"]
    },
    {
      "why": "The item cards fill the Upgrade bay entries and the workshop plaques.",
      "paths": ["src/features/descriptions/**"],
      "specs": ["e2e/browser/itemCards.spec.ts", "e2e/browser/workshop.spec.ts"]
    },
    {
      "why": "The workshop showcase is the Upgrade bay screen and the Works' turntable.",
      "paths": ["src/features/workshop/**"],
      "specs": [
        "e2e/browser/workshop.spec.ts",
        "e2e/browser/itemCards.spec.ts",
        "e2e/browser/shops.spec.ts",
        "e2e/browser/dockBuildings.spec.ts",
        "e2e/browser/screens/reviewShots.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts"
      ]
    },
    {
      "why": "The dock buildings stand in the zoomed-out frame the draw-call budgets measure.",
      "paths": ["src/features/dock-buildings/**"],
      "specs": [
        "e2e/browser/dockBuildings.spec.ts",
        "e2e/browser/render.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts",
        "e2e/browser/screens/reviewShots.spec.ts"
      ]
    },
    {
      "why": "The render rules set what the frame draws: budgets, the showcase car, mounted parts, the look set.",
      "paths": ["src/systems/render/**"],
      "specs": [
        "e2e/browser/render.spec.ts",
        "e2e/browser/dockBuildings.spec.ts",
        "e2e/browser/sellBurst.spec.ts",
        "e2e/browser/shops.spec.ts",
        "e2e/browser/workshop.spec.ts",
        "e2e/browser/vehiclePieces.spec.ts",
        "e2e/browser/dynamiteVisuals.spec.ts",
        "e2e/browser/miningGates.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts",
        "e2e/browser/screens/reviewShots.spec.ts",
        "e2e/browser/magneticPlanet.spec.ts",
        "e2e/browser/chunkWorker.spec.ts"
      ]
    },
    {
      "why": "The chunk worker (ticket 337): its root and port, the job stream and the pool that meshes its results.",
      "paths": [
        "src/chunkWorker.ts",
        "src/shell/chunkWorkerPort.ts",
        "src/scene/chunkJobStream.ts",
        "src/scene/chunkMeshPool.ts",
        "src/scene/chunkMeshGeometry.ts",
        "src/scene/chunkBuildNeeds.ts",
        "src/scene/chunkStreamFrame.ts",
        "src/scene/PlanetTerrain.tsx"
      ],
      "specs": ["e2e/browser/chunkWorker.spec.ts", "e2e/browser/render.spec.ts"]
    },
    {
      "why": "The memory reads of the debug API and the run log's samples.",
      "paths": [
        "src/debug/debugMemory.ts",
        "src/scene/rendererMemory.ts",
        "src/scene/sceneMemory.ts",
        "src/scene/PerfSampler.tsx"
      ],
      "specs": ["e2e/browser/memory.spec.ts", "e2e/browser/memorySample.spec.ts"]
    },
    {
      "why": "A debug run's snapshot writers: triggers, the one writer, IndexedDB, the zip, the canvas shot.",
      "paths": [
        "src/systems/snapshots/**",
        "src/store/runSnapshots.ts",
        "src/store/perfLog.ts",
        "src/store/checkpoint.ts",
        "src/shell/browserSnapshots.ts",
        "src/shell/storedZip.ts",
        "src/scene/canvasScreenshots.ts",
        "src/scene/CanvasScreenshots.tsx"
      ],
      "specs": ["e2e/browser/snapshots.spec.ts"]
    },
    {
      "why": "Replay and snapshots give smoke's digests; the camera gives its framing checks.",
      "paths": [
        "src/systems/replay/**",
        "src/scene/PlanetCamera.tsx",
        "src/scene/cameraPresence.ts"
      ],
      "specs": ["e2e/browser/smoke.spec.ts", "e2e/browser/screens/screenLayout.spec.ts"]
    },
    {
      "why": "The high-speed camera reads the felt speed and the drill's facing (ticket 338).",
      "paths": [
        "src/scene/PlanetCamera.tsx",
        "src/scene/cameraPresence.ts",
        "src/scene/motionPresence.ts",
        "src/scene/drillPresence.ts",
        "src/systems/render/speedFraming.ts"
      ],
      "specs": ["e2e/browser/speedCamera.spec.ts"]
    },
    {
      "why": "The committed scenarios the specs open with ?scenario=.",
      "paths": ["scenarios/planet1-start.scenario.json", "scenarios/broken.scenario.json"],
      "specs": ["e2e/browser/smoke.spec.ts", "e2e/browser/miningPopup.spec.ts"]
    },
    {
      "why": "The gamepad adapter (ticket 346): the shell's poll, pad codes and frames, the pad runtime.",
      "paths": [
        "src/shell/gamepadHooks.ts",
        "src/store/padRuntime.ts",
        "src/systems/input/padCodes.ts",
        "src/systems/input/padFrame.ts",
        "src/constants/gamepad.ts"
      ],
      "specs": ["e2e/browser/gamepad.spec.ts"]
    },
    {
      "why": "Keys and the canvas's mouse buttons become actions: the shell's listeners, the action map, the input runtime (ticket 345).",
      "paths": [
        "src/shell/mouseHooks.ts",
        "src/shell/sharedBrowserHooks.ts",
        "src/data/input/actions.json",
        "src/systems/input/actionMap.ts",
        "src/systems/input/keyCodes.ts",
        "src/store/inputRuntime.ts"
      ],
      "specs": [
        "e2e/browser/mouseInput.spec.ts",
        "e2e/browser/screens/touchControls.spec.ts",
        "e2e/browser/smoke.spec.ts"
      ]
    },
    {
      "why": "The touch controls, and the specs that drive the game by touch.",
      "paths": ["src/ui/touch/**"],
      "specs": [
        "e2e/browser/screens/touchControls.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts",
        "e2e/browser/screens/reviewShots.spec.ts",
        "e2e/browser/itemCards.spec.ts",
        "e2e/browser/workshop.spec.ts"
      ]
    },
    {
      "why": "The store sells researched vehicle items: the buy command, the sellers, the bay rows.",
      "paths": [
        "src/systems/authority/vehicleItemRules.ts",
        "src/systems/registries/vehicleItemSales.ts",
        "src/systems/views/vehicleItemRows.ts",
        "src/features/tech-tree/systems/itemShop.ts",
        "src/features/mobility/systems/mobilitySales.ts",
        "src/features/power-up-core/systems/cradleSales.ts",
        "src/features/mining-gates/systems/rigSales.ts"
      ],
      "specs": [
        "e2e/browser/vehicleItemShop.spec.ts",
        "e2e/browser/itemCards.spec.ts",
        "e2e/browser/workshop.spec.ts"
      ]
    },
    {
      "why": "The mining gates' looks in the ground and the debug reads that check them (ticket 299).",
      "paths": ["src/features/mining-gates/**"],
      "specs": ["e2e/browser/miningGates.spec.ts"]
    },
    {
      "why": "The magnetic planet's aurora on the kernel sky band and planet-mix's field-line layer and asset (#293).",
      "paths": [
        "src/features/planet-mix/scene/**",
        "src/features/planet-mix/systems/render/**",
        "src/features/planet-mix/magneticLooks.json",
        "src/scene/PlanetSkyBand.tsx",
        "src/scene/skyBandPresence.ts",
        "src/systems/registries/planetSkyBand.ts",
        "public/assets/prop/prop-magnetic-field/**"
      ],
      "specs": ["e2e/browser/magneticPlanet.spec.ts", "e2e/browser/render.spec.ts"]
    },
    {
      "why": "The kernel planet card and the lines the slices add to it (ticket 343).",
      "paths": [
        "src/systems/registries/planetCardLines.ts",
        "src/systems/views/planetCardView.ts",
        "src/store/planetCardSlice.ts",
        "src/ui/planet/**",
        "src/features/planet-mix/systems/planetCard.ts",
        "src/features/planet-mix/systems/planetCardSources.ts",
        "src/features/planet-mix/planetCards.json"
      ],
      "specs": ["e2e/browser/planetCard.spec.ts"]
    },
    {
      "why": "The game stage fits every screen cell and shows the portrait card.",
      "paths": ["src/ui/stage/**"],
      "specs": [
        "e2e/browser/screens/portrait.spec.ts",
        "e2e/browser/screens/screenLayout.spec.ts",
        "e2e/browser/screens/touchControls.spec.ts",
        "e2e/browser/screens/reviewShots.spec.ts"
      ]
    },
    {
      "why": "Mark milestone verbs (#256, ticket 276): the core's follow-ups and links, and the corer, beacon, drain, auger and bit cases.",
      "paths": [
        "src/features/power-up-core/**",
        "src/features/tech-tree/**",
        "src/features/terrain-tools/**",
        "src/features/extraction/**",
        "src/features/drill-gear/**",
        "src/features/sensing/**"
      ],
      "specs": ["e2e/browser/markMilestones.spec.ts"]
    }
  ]
}
