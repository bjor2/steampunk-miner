{
  "name": "steampunk-miner",
  "private": true,
  "version": "0.1.0",
  "description": "Infinite 2D steampunk mining game (browser first, shipped to Steam inside Electron).",
  "author": "Bjor Byrkjedal",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:push": "cross-env SKIP_NIGHTLY_ONLY_TESTS=1 vitest run",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test -c playwright.electron.config.ts",
    "screens:update": "UPDATE_SCREENS=1 playwright test e2e/browser/screens/reviewShots.spec.ts",
    "bench:world": "vite-node scripts/benchGenerateChunk.ts",
    "bench:render": "vite-node scripts/benchChunkBatch.ts",
    "bench:ground": "vite-node scripts/benchGround.ts",
    "bench:combat": "vite-node scripts/benchCombatTick.ts",
    "bench:summary": "vite-node scripts/bench/summarizeBenchLogs.ts",
    "perf:record": "node scripts/perf/recordPerf.mjs",
    "perf:sessions": "vite-node scripts/perf/analyzeSessions.ts",
    "metrics:ticket": "node scripts/metrics/ticketPhases.mjs",
    "metrics:backfill": "node scripts/metrics/ticketPhases.mjs --backfill",
    "metrics:tests": "node scripts/ci/queryTestMetrics.mjs",
    "soak:memory": "npm run build && node scripts/soak/soakMemory.mjs --minutes 10 --out test-results/soak",
    "golden:update": "vite-node scripts/updateGoldenRuns.ts",
    "balance:report": "vite-node scripts/balanceReport.ts",
    "balance:baseline": "vite-node scripts/balanceReport.ts --write-baseline",
    "balance:planets": "vite-node scripts/balancePlanets.ts",
    "balance:guns": "vite-node scripts/balanceGuns.ts",
    "balance:charges": "vite-node scripts/balanceCharges.ts",
    "balance:refinery": "vite-node scripts/balanceRefinery.ts",
    "balance:heat": "vite-node scripts/balanceHeat.ts",
    "art:export": "scripts/art/export.sh",
    "art:merge-check": "scripts/art/merge_check.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "art:icons": "vite-node scripts/art/authorIcons.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "decimal.js": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "wait-on": "^9.5.1"
  }
}
